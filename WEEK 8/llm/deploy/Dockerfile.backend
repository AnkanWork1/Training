# Use an official Python runtime as a parent image
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Copy backend code
COPY deploy/requirements.txt /app/requirements.txt
COPY quantized/model.gguf /app/quantized/model.gguf
COPY llama.cpp/build/bin/llama-server /app/llama-server
COPY deploy /app/deploy
# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Make llama-server executable
RUN chmod +x /app/llama-server

# Expose ports
# 8000 = FastAPI, 8080 = llama-server
EXPOSE 8000 8080

# Set environment variables for your app
ENV MODEL_NAME=/app/quantized/model.gguf
ENV MODEL_TYPE=gguf
ENV LLAMA_SERVER_PATH=/app/llama-server
ENV BASE_URL=http://127.0.0.1:8080/v1
ENV API_KEY=dummy
ENV TEMPERATURE=0.3
ENV TOP_P=0.9
ENV TOP_K=40
ENV MAX_TOKENS=128
ENV DEFAULT_SYSTEM="You are a precise AI tutor. Answer correctly, avoid hallucinations, and stay strictly on the topic."

# Start llama-server in the background and then start FastAPI app
CMD /app/llama-server --model /app/quantized/model.gguf --port 8080 --ctx-size 2048 --temp 0.3 --repeat-penalty 1.1 & \
    uvicorn deploy.app:app --host 0.0.0.0 --port 8000 --reload